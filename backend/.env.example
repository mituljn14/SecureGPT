# Copy to backend/.env and adjust. Everything here has a working default for a
# single-machine, fully local setup; only JWT_SECRET_KEY must be changed.

# ---- Vector store ----------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=securegpt_v2
QDRANT_TIMEOUT=60
EMBED_DIM=1024

# ---- LLM (Ollama, OpenAI-compatible endpoint) -------------------------------
LLM_DEPLOYMENT_TYPE=on_premise
ON_PREMISE_API_BASE=http://localhost:11434/v1
ON_PREMISE_MODEL=openai/llama3.2:3b
ON_PREMISE_API_KEY=ollama

# Coding agent talks to Ollama directly
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
LLM_TIMEOUT=180

# Vision agent models (Ollama tags)
VISION_MODEL=moondream
TEXT_MODEL=llama3.2:3b

# Meeting agent
WHISPER_MODEL=base

# ---- Auth -----------------------------------------------------------------
# Any long random string. Tokens are signed with it; change it and every
# signed-in user is logged out.
JWT_SECRET_KEY=change-me-to-a-long-random-string
# 1 = the /login/demo one-click role endpoint is enabled (prototype only)
PROTOTYPE_AUTH=1

# ---- Access control ---------------------------------------------------------
# role        = a user reads only chunks tagged with their role (+ CEO reads all)
# department  = additionally every chunk in the user's department
RBAC_SCOPE=role

# ---- Company identity (used by the supervisor prompt and routing rules) ------
COMPANY_NAME=Nova Automobile Engineering Solutions Pvt. Ltd.
COMPANY_ALIASES=Nova Engineering, Nova, NAES

# ---- Retrieval gates (see docs/query-lifecycle) -----------------------------
DENSE_RELEVANCE_THRESHOLD=0.50
FAST_PATH_CONFIDENCE_THRESHOLD=0.55
VISION_SOURCE_THRESHOLD=0.65
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHUNKS=5
IDENTIFIER_LOOKUP_LIMIT=3
IDENTIFIER_MIN_LEN=5

# ---- Paths (defaults resolve to <repo>/corpus and <repo>/markdown) ----------
# CORPUS_ROOT=
# MARKDOWN_ROOT=

# ---- Evaluation only (backend/evaluation) -----------------------------------
# RAGAS judge: defaults to local Ollama ministral-3:8b; point at any
# OpenAI-compatible endpoint for a bigger judge.
# RAGAS_JUDGE_API_BASE=http://localhost:11434/v1
# RAGAS_JUDGE_MODEL=ministral-3:8b
# RAGAS_JUDGE_API_KEY=ollama
# RUNPOD_API_KEY=            # only for evaluation/runpod_judge.py
