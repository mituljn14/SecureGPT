# Environment Configuration for Local Vision Agent
# Copy this to .env and adjust if necessary.

# Ollama Vision LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=moondream

# Qdrant Vector Database Settings
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=securegpt_v2
QDRANT_API_KEY=

# Embedding Model Settings (for Qdrant similarity search)
# Embeddings come from retrieval_pipeline (FlagEmbedding BGE-M3); this is informational only.
EMBEDDING_MODEL=BAAI/bge-m3

# Processing & Safety Settings
MAX_IMAGE_DIMENSION=1280
OCR_ENGINE=rapidocr
LOG_LEVEL=INFO
